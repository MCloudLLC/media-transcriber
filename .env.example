# ─────────────────────────────────────────────
# media-transcriber environment configuration
# Copy this file to .env and fill in your values.
# .env is loaded automatically on startup.
# ─────────────────────────────────────────────

# ── Azure Speech-to-Text (required for --backend azure) ──────────────────────
AZURE_SPEECH_KEY=your_azure_speech_api_key_here
AZURE_AI_LOCATION=eastus

# ── Q&A: OpenAI-compatible API key ───────────────────────────────────────────
# Required only when using OpenAI or a hosted LLM endpoint in the Q&A tab.
# Leave unset (or blank) when using Ollama — it needs no key.
OPENAI_API_KEY=your_openai_api_key_here

# ── Speaker diarization (required for --diarize) ─────────────────────────────
# HuggingFace access token. Create one at https://hf.co/settings/tokens and
# accept the licenses for pyannote/speaker-diarization-3.1 and
# pyannote/segmentation-3.0. Install the backend with: uv sync --extra diarize
HF_TOKEN=your_huggingface_token_here
